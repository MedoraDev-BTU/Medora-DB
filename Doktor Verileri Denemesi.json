    {
      "parameters": {
        "jsCode": "// 1. Webhook'tan orijinal adresi alıyoruz\nconst originalUrl = $('Webhook').first().json.body.url;\nconst urlParts = originalUrl.split('/');\nconst baseUrl = urlParts[0] + \"//\" + urlParts[2];\n\n// 2. Information Extractor'dan çıkan veriyi al\nlet data = $input.first().json;\nlet doctors = data.output || data; \n\nif (!Array.isArray(doctors)) {\n  doctors = [doctors];\n}\n\n// 4. Her doktorun fotoğraf linkini kontrol et\ndoctors.forEach(doktor => {\n  let imgUrl = doktor.fotograf_url_adresi || doktor.fotograf || \"\";\n  \n  if (imgUrl.trim() !== \"\") {\n    \n    // GÜVENLİK: Eğer link bilerek uydurulmuşsa (.svg ikonuysa veya doktor profil linkiyse)\n    if (imgUrl.toLowerCase().includes('.svg') || (imgUrl.includes('/doktor/') && !imgUrl.includes('.'))) {\n      imgUrl = \"\"; // Çöpe at\n    } else {\n      // Eğer gerçek bir linkse ve başında http yoksa, site adresini ekle\n      if (!imgUrl.startsWith('http')) {\n        imgUrl = baseUrl + (imgUrl.startsWith('/') ? '' : '/') + imgUrl;\n      }\n    }\n  }\n\n  // Temizlenen (veya domain eklenen) linki her halükarda nesneye geri kaydet\n  if (\"fotograf_url_adresi\" in doktor) doktor.fotograf_url_adresi = imgUrl;\n  if (\"fotograf\" in doktor) doktor.fotograf = imgUrl;\n});\n\nreturn data;\n"
      },
